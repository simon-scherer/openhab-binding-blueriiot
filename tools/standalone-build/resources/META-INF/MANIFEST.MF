Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-SymbolicName: org.openhab.binding.blueriiot
Bundle-Name: openHAB Add-ons :: Bundles :: Blue Riiot Binding
Bundle-Vendor: openHAB.org
Bundle-Version: 5.2.4
Bundle-License: https://www.eclipse.org/legal/epl-2.0/
Bundle-Description: Blue Riiot / Blue Connect pool analysers via the Blue Riiot cloud
Import-Package: com.google.gson;version="[2.8,3)",
 com.google.gson.annotations;version="[2.8,3)",
 javax.crypto,
 javax.crypto.spec,
 javax.measure;version="[2.0,3)",
 javax.measure.quantity;version="[2.0,3)",
 org.eclipse.jetty.client;version="[9.4,10)",
 org.eclipse.jetty.client.api;version="[9.4,10)",
 org.eclipse.jetty.client.util;version="[9.4,10)",
 org.eclipse.jetty.http;version="[9.4,10)",
 org.openhab.core.config.discovery;version="[5.0,6)",
 org.openhab.core.io.net.http;version="[5.0,6)",
 org.openhab.core.library.types;version="[5.0,6)",
 org.openhab.core.library.unit;version="[5.0,6)",
 org.openhab.core.thing;version="[5.0,6)",
 org.openhab.core.thing.binding;version="[5.0,6)",
 org.openhab.core.types;version="[5.0,6)",
 org.slf4j;version="[1.7,3)"
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=21))"
Service-Component: OSGI-INF/org.openhab.binding.blueriiot.internal.BlueRiiotHandlerFactory.xml,
 OSGI-INF/org.openhab.binding.blueriiot.internal.discovery.BlueRiiotDiscoveryService.xml
